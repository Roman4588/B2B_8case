# Единственный ресурс Amvera, deploy/amvera/Dockerfile.standalone.
SESSION_SECURE=true
DEMO_MODE=true
# Старые аккаунты и инструкции из /data/app.db переносятся автоматически один раз.
# ADMIN_EMAIL / ADMIN_PASSWORD / ADMIN_NAME нужны только при создании НОВОГО администратора.
# Если заданы, вводить только через секреты Amvera, не сохранять реальные значения в Git.
# PostgreSQL/Redis/Prometheus/exporter используют loopback внутри этого контейнера.
# Пароль внутренней PostgreSQL генерируется в /data/.postgres-password и сохраняется при перезапуске.
