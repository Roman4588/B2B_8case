FROM node:22-alpine AS frontend-build
WORKDIR /src
COPY frontend/package*.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM prom/prometheus:v3.5.0 AS prometheus
# Published backend provides the pinned Python dependencies; source below replaces its application code.
FROM ghcr.io/roman4588/b2b_8case/backend:v1.0.0
USER root
RUN mkdir -p /etc/postgresql-common \
    && printf 'create_main_cluster = false\n' > /etc/postgresql-common/createcluster.conf \
    && sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends nginx ca-certificates postgresql-17-pgvector redis-server \
    && rm -f /etc/nginx/sites-enabled/default \
    && sed -i 's/worker_processes auto;/worker_processes 1;/' /etc/nginx/nginx.conf \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY backend/ ./
COPY --from=frontend-build /src/dist /usr/share/nginx/html
COPY --from=prometheus /bin/prometheus /usr/local/bin/prometheus
COPY deploy/amvera/nginx.conf /etc/nginx/conf.d/default.conf
COPY deploy/amvera/prometheus.yml /etc/prometheus/prometheus.yml
COPY deploy/prometheus/alerts.yml /etc/prometheus/alerts.yml
COPY deploy/demo-exporter/app.py /opt/exporter.py
ENV SESSION_SECURE=true
EXPOSE 80
STOPSIGNAL SIGTERM
CMD ["python", "-m", "app.processes", "standalone"]
