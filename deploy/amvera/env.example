# Шаблон для ручного переноса в переменные Amvera, не готовые секреты.
# DATABASE_URL: пароль должен быть URL-encoded.
DATABASE_URL=postgresql+psycopg://copilot:REPLACE_URL_ENCODED_PASSWORD@REPLACE_DB_PRIVATE_HOST:5432/copilot
REDIS_URL=redis://REPLACE_REDIS_PRIVATE_HOST:6379/0
PROMETHEUS_URL=http://REPLACE_PROMETHEUS_PRIVATE_HOST:9090
PROMETHEUS_TOKEN=
MODEL_CACHE=/data/models
UPLOAD_DIR=/data/uploads
SESSION_SECURE=true
HF_HUB_DISABLE_TELEMETRY=1
# Учебный мониторинг. Для реального Prometheus: false.
DEMO_MODE=true
DEMO_EXPORTER_URL=http://REPLACE_EXPORTER_PRIVATE_HOST:9101
# Только Web, для создания нового администратора. Заполнить в секретах Amvera.
# ADMIN_EMAIL=
# ADMIN_NAME=
# ADMIN_PASSWORD=
